APP_ENV=development
API_TITLE=Plant Disease Detection API
API_VERSION=1.0.0
API_HOST=127.0.0.1
API_PORT=7800

DEFAULT_MODEL_NAME=best.onnx
MODELS_DIR=./models
CLASS_NAMES_PATH=./class_names.json
MODEL_INPUT_WIDTH=640
MODEL_INPUT_HEIGHT=640
TOP_K=3
CONFIDENCE_THRESHOLD=0.10
IOU_THRESHOLD=0.45

ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
BOOTSTRAP_ADMIN_USERNAME=root
BOOTSTRAP_ADMIN_PASSWORD=change_me
BOOTSTRAP_USER_USERNAME=root_user
BOOTSTRAP_USER_PASSWORD=

ANNOTATION_DATASETS_ROOT=./annotation_datasets
AUTH_DB_PATH=./plant_auth.db
TRAINING_RUNS_DIR=./training_runs
TRAINING_BASE_MODEL=yolov8n.pt
TRAINING_EPOCHS=30
TRAINING_IMGSZ=640
# Optional: point training jobs at a dedicated Python 3.12 environment.
# TRAINING_PYTHON_PATH=./.venv-train/bin/python

AI_API_URL=
AI_API_KEY=
AI_API_MODEL=
AI_API_TIMEOUT=25

MAX_UPLOAD_BYTES=536870912
MAX_ZIP_MEMBERS=20000
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648
